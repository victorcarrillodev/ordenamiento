# ── Variables de entorno para Docker Compose (plantilla) ─────────────
# Copia este archivo a `.env` en la raíz del proyecto y ajústalo.
# `.env` está en .gitignore: NUNCA hagas commit de tus secretos reales.

# ── Base de datos (por defecto ya la da el compose) ──
# DATABASE_URL=postgres://postgres:postgres@db:5432/ordenamiento

# ── Sesiones ──
# Obligatorio cambiar en cualquier entorno que no sea local
SESSION_SECRET=pon-un-secreto-largo-y-aleatorio-aqui

# ── Cuenta ROOT (única y permanente) ──
# Obligatorio en producción: define un password fuerte aquí (o en secrets).
# Este archivo es una plantilla; tus valores reales van en `.env` (gitignorado).
ROOT_EMAIL=root@ordenamiento.gob.mx
ROOT_PASSWORD=REEMPLAZA_CON_UN_PASSWORD_FUERTE
ROOT_NAME=Administrador Root

# ── Correo opcional (envío de participaciones) ──
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=cuenta@dominio.com
# SMTP_PASS=contraseña
# MAIL_FROM=bitacora@dominio.com
