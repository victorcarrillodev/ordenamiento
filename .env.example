# Configuración del entorno para Docker Compose
# Copia este archivo a `.env` si deseas personalizar credenciales en producción.

# ── Sesiones (backend) ──
SESSION_SECRET=secreto-para-firma-de-cookies-ordenamiento-2026

# ── Cuenta ROOT (dueña del sistema) ──
# Manda sobre todas las cuentas y es la unica que reparte el rango root.
# Se siembra en cada arranque; si ya existia con otro rango, se eleva a root.
ROOT_EMAIL=victorcarrillo.dev@gmail.com
ROOT_PASSWORD=CambiaEstaContrasena2026!
ROOT_NAME=Victor Carrillo Rojas

# ── Correo saliente (acuses, avisos, recuperación de contraseña y bienvenida) ──
# Sin SMTP_HOST el envío queda deshabilitado y "¿Olvidaste tu contraseña?"
# responde que el correo no está configurado en vez de fallar en silencio.
# El remitente NO se configura aquí: todos los correos salen del correo de
# contacto del pie de página (Personalización → Textos del portal), que por
# omisión es ordenamiento@tlaquepaque.gob.mx. El servidor SMTP debe tener
# autorizado enviar con esa dirección.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Origen público del portal ──
# Base del enlace que viaja en el correo de recuperación de contraseña.
# En producción debe ser la URL real, con https, sin barra final ni /ordena:
#   APP_PUBLIC_URL=https://ac.tlaquepaque.gob.mx
APP_PUBLIC_URL=http://localhost:44100
