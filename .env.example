# Variables para el docker-compose.yml de la raíz (stack completo: db + backend + web).
# Copia este archivo a `.env` en la raíz del proyecto y ajusta los valores reales.
# `.env` está en .gitignore: NUNCA hagas commit de tus secretos.

# ── Sesiones (backend) ──
SESSION_SECRET=pon-un-secreto-largo-y-aleatorio-aqui

# ── Cuenta ROOT (única y permanente) ──
ROOT_EMAIL=root@ordenamiento.gob.mx
ROOT_PASSWORD=REEMPLAZA_CON_UN_PASSWORD_FUERTE
ROOT_NAME=Administrador Root
