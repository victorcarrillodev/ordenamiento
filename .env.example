# Configuración del entorno para Docker Compose
# Copia este archivo a `.env` si deseas personalizar credenciales en producción.

# ── Sesiones (backend) ──
SESSION_SECRET=secreto-para-firma-de-cookies-ordenamiento-2026

# ── Cuenta ROOT de Administración ──
ROOT_EMAIL=root@ordenamiento.gob.mx
ROOT_PASSWORD=AdminRoot2026!
ROOT_NAME=Administrador Root

# ── Correo saliente (acuses, avisos y recuperación de contraseña) ──
# Sin SMTP_HOST el envío queda deshabilitado y "¿Olvidaste tu contraseña?"
# responde que el correo no está configurado en vez de fallar en silencio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Origen público del portal ──
# Base del enlace que viaja en el correo de recuperación de contraseña.
# En producción debe ser la URL real, con https, sin barra final ni /ordena:
#   APP_PUBLIC_URL=https://ac.tlaquepaque.gob.mx
APP_PUBLIC_URL=http://localhost:44100
